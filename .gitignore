# ==========================================
# DevDNA - Root .gitignore
# ==========================================

# Node dependencies
node_modules/
**/node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
**/.venv/
**/venv/

# Machine Learning
# Exclude ML from V1
/Server/MachineLearning/
/data/

# Build output
dist/
build/
**/dist/
**/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python cache
__pycache__/
*.py[cod]

# Testing / coverage
coverage/
.nyc_output/
.pytest_cache/
.mypy_cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/

# Temporary files
*.tmp
*.temp
*.swp
*.swo